{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-hub.local/schemas/contracts-v2.json",
  "title": "Agent Hub v2 public contracts",
  "$defs": {
    "task_v2": {
      "type": "object",
      "required": ["schema", "intent", "capability", "constraints", "retention"],
      "properties": {
        "schema": {"const": "task_v2"},
        "intent": {"type": "string", "minLength": 1},
        "capability": {"enum": ["chat", "search", "vision", "write", "image", "inspect", "review", "decide"]},
        "inline_input": {"type": "string"},
        "input_artifacts": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "object"},
        "output_contract": {"type": "object"},
        "retention": {"enum": ["ephemeral", "durable_private", "exportable"]}
      },
      "additionalProperties": false
    },
    "plan_v2": {
      "type": "object",
      "required": ["schema", "task", "steps", "routing_mode", "policy_revision", "plan_sha256"],
      "properties": {
        "schema": {"const": "plan_v2"},
        "task": {"$ref": "#/$defs/task_v2"},
        "steps": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "routing_mode": {"enum": ["pinned", "shadow", "advisory", "auto"]},
        "policy_revision": {"type": "integer", "minimum": 0},
        "egress_manifest_sha256": {"type": ["string", "null"]},
        "inline_consent_artifacts": {"type": "array", "items": {"type": "string"}},
        "request_plan_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "run_v3": {
      "type": "object",
      "required": ["schema", "run_id", "revision", "status", "plan_sha256", "steps"],
      "properties": {
        "schema": {"const": "run_v3"},
        "run_id": {"type": "string"},
        "revision": {"type": "integer", "minimum": 0},
        "status": {"enum": ["prepared", "queued", "running", "waiting_approval", "paused", "completed", "failed", "cancelled", "archived", "outcome_unknown"]},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "steps": {"type": "array", "items": {"type": "object"}}
      }
    },
    "event_v2": {
      "type": "object",
      "required": ["schema", "cursor", "run_id", "run_revision", "type", "details"],
      "properties": {
        "schema": {"const": "event_v2"},
        "cursor": {"type": "integer", "minimum": 1},
        "run_id": {"type": "string"},
        "run_revision": {"type": "integer", "minimum": 0},
        "type": {"type": "string"},
        "details": {"type": "object"}
      }
    },
    "artifact_v2": {
      "type": "object",
      "required": ["schema", "artifact_id", "content_sha256", "media_type", "sensitivity", "provenance"],
      "properties": {
        "schema": {"const": "artifact_v2"},
        "artifact_id": {"type": "string"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "media_type": {"type": "string"},
        "sensitivity": {"enum": ["public", "project", "sensitive", "secret"]},
        "provenance": {"type": "object"}
      }
    },
    "provider_manifest_v2": {
      "type": "object",
      "required": ["schema", "provider_id", "adapter_version", "protocol_version", "capabilities", "auth_owner", "auth_mode", "allowed_domains"],
      "properties": {
        "schema": {"const": "agent_hub_provider_v2"},
        "provider_id": {"type": "string"},
        "adapter_version": {"type": "string"},
        "protocol_version": {"const": "2.0"},
        "capabilities": {"type": "array", "items": {"type": "string"}},
        "auth_owner": {"type": "string"},
        "auth_mode": {"type": "string"},
        "allowed_domains": {"type": "array", "items": {"type": "string"}},
        "context_limits": {
          "type": "object",
          "required": ["default_max_input_tokens", "model_overrides"],
          "properties": {
            "default_max_input_tokens": {"type": "integer", "minimum": 1, "maximum": 10000000},
            "model_overrides": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "required": ["model_prefix", "max_input_tokens"],
                "properties": {
                  "model_prefix": {"type": "string"},
                  "max_input_tokens": {"type": "integer", "minimum": 1, "maximum": 10000000}
                }
              }
            }
          }
        }
      }
    },
    "routing_decision_v1": {
      "type": "object",
      "required": ["schema", "decision_id", "routing_mode", "candidates", "selected_provider"],
      "properties": {
        "schema": {"const": "routing_decision_v1"},
        "decision_id": {"type": "string"},
        "routing_mode": {"enum": ["pinned", "shadow", "advisory", "auto"]},
        "candidates": {"type": "array", "items": {"type": "object"}},
        "selected_provider": {"type": "string"}
      }
    },
    "egress_review_v1": {
      "type": "object",
      "required": ["schema", "review_id", "proposal_sha256", "manifest_sha256", "project_root", "policy_revision", "provider", "destinations", "entries", "status", "created_at", "expires_at"],
      "properties": {
        "schema": {"const": "agent_hub_egress_review_v1"},
        "review_id": {"type": "string"},
        "proposal_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "project_root": {"type": "string"},
        "policy_revision": {"type": "integer", "minimum": 0},
        "provider": {"type": "string"},
        "model": {"type": ["string", "null"]},
        "destinations": {"type": "array", "items": {"type": "string"}},
        "entries": {"type": "array", "items": {"type": "object"}},
        "status": {"enum": ["pending", "approved", "rejected", "consumed", "expired"]},
        "created_at": {"type": "number"},
        "expires_at": {"type": "number"},
        "decided_at": {"type": ["number", "null"]},
        "consumed_at": {"type": ["number", "null"]}
      }
    },
    "egress_manifest_v2": {
      "type": "object",
      "required": ["schema", "provider", "destinations", "policy_revision", "entries", "manifest_sha256"],
      "properties": {
        "schema": {"const": "egress_manifest_v2"},
        "provider": {"type": "string"},
        "destinations": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
        "model": {"type": ["string", "null"]},
        "policy_revision": {"type": "integer", "minimum": 0},
        "entries": {"type": "array", "items": {"type": "object"}},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}

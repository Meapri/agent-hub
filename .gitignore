htmlcov/

# Ruler run-time bridge (created only for the lifetime of a sync)
/.ruler

# basic-memory runtime state (config.json, memory.db, fastembed cache).
# The human-readable notes in memory/data/ ARE tracked; this local state is not.
/memory/.basic-memory/

# macOS / editor
.DS_Store
*.bak

# Local plugin marketplace cache; keep the installable Codex catalog manifest.
.agents/*
!.agents/plugins/
.agents/plugins/*
!.agents/plugins/marketplace.json
